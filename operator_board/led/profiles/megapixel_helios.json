{
  "id": "megapixel_helios",
  "name": "Megapixel HELIOS",
  "manufacturer": "Megapixel VR",
  "transport": "http",
  "default_port": 80,
  "notes": "HELIOS HTTP API as used by the Bitfocus Companion 'mvr-helios' module (2.3): changes are POSTed as JSON to /api/v1/public (dev.display.blackout / freeze / brightness, dev.ingest.testPattern). Older firmware may not answer. Basic/Digest auth can be set in the processor options (username/password).",
  "status_command": {
    "method": "GET",
    "path": "/api/v1/public"
  },
  "options": [
    {
      "name": "username",
      "label": "Username",
      "default": ""
    },
    {
      "name": "password",
      "label": "Password",
      "default": ""
    },
    {
      "name": "scheme",
      "label": "Scheme (http/https)",
      "default": "http"
    }
  ],
  "commands": {
    "blackout_on": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "display": {
            "blackout": true
          }
        }
      },
      "confidence": "source"
    },
    "blackout_off": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "display": {
            "blackout": false
          }
        }
      },
      "confidence": "source"
    },
    "freeze_on": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "display": {
            "freeze": true
          }
        }
      },
      "confidence": "source"
    },
    "freeze_off": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "display": {
            "freeze": false
          }
        }
      },
      "confidence": "source"
    },
    "test_pattern_off": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "ingest": {
            "testPattern": {
              "enabled": false
            }
          }
        }
      },
      "confidence": "source"
    },
    "brightness": {
      "method": "POST",
      "path": "/api/v1/public",
      "json": {
        "dev": {
          "display": {
            "brightness": "{value}"
          }
        }
      },
      "confidence": "source",
      "value": {
        "min": 0,
        "max": 100,
        "format": "int",
        "unit": "%"
      }
    }
  },
  "test_patterns": [
    {
      "id": "red",
      "label": "Red",
      "commands": [
